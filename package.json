{
  "name": "we-r-hvac",
  "version": "1.0.0",
  "description": "We R HVAC website: Payload CMS (local, SQLite) + static export to GitHub Pages",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/seed.ts",
    "export:content": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/export-content.ts",
    "reviews": "node scripts/fetch-reviews.mjs",
    "build:static": "node scripts/build-static.mjs",
    "preview:static": "node scripts/serve-static.mjs",
    "publish:site": "node scripts/publish.mjs",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "typecheck": "tsc --noEmit",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint ."
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "lucide-react": "^0.468.0",
    "next": "16.4.1",
    "payload": "3.93.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "sharp": "0.35.4",
    "vanilla-cookieconsent": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.1",
    "prettier": "^3.4.2",
    "tsx": "4.23.15",
    "typescript": "5.7.3"
  }
}
